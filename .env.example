# Copy to .env. The search tool needs a Tavily key; the other keys are optional.
TAVILY_API_KEY=your_tavily_api_key_here
# Optional: use You.com instead. Keyless works for demos and small evals (100 searches/day);
# set YDC_API_KEY for RL rollouts.
# HYBRID_SEARCH_PROVIDER=youcom
# YDC_API_KEY=your_you_com_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
